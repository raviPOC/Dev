<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Form Renderer</masterLabel>
    <description>Renders dynamic forms created with the Form Builder</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__Tab,lightningCommunity__Page,lightningCommunity__Default">
            <property name="formDefinitionId" type="String" label="Form Definition ID" description="The ID of the form definition to render"/>
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Form_Definition__c</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
