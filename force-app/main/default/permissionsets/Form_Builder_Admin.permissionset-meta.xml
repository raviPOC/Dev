<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Full access to Form Builder functionality including creating, editing, and viewing forms and responses</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Form Builder Admin</label>
    <license>Salesforce</license>
    
    <!-- Object Permissions -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Form_Definition__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Form_Response__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    
    <!-- Field Permissions for Form_Definition__c -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Definition__c.Description__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Definition__c.Form_JSON__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Definition__c.Is_Active__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Definition__c.Target_Object__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <!-- Field Permissions for Form_Response__c -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Response__c.Form_Definition__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Response__c.Response_JSON__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Response__c.Submission_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Response__c.Submitted_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Form_Response__c.Target_Record_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <!-- Tab Visibility -->
    <tabSettings>
        <tab>Form_Builder</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Form_List</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Form_Responses</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    
    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>FormBuilderController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
